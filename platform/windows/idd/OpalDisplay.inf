[Version]
PnpLockDown=1
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=OPALDisplay.cat
DriverVer=09/10/2026,0.2.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...17134,NTarm64.10.0...17134

[Standard.NTamd64.10.0...17134]
%DeviceName%=OPALDisplay_Install,Root\OPALDISPLAY

[Standard.NTarm64.10.0...17134]
%DeviceName%=OPALDisplay_Install,Root\OPALDISPLAY

[SourceDisksFiles]
OPALDisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[OPALDisplay_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[OPALDisplay_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=OPALDisplay_HardwareSettings

[OPALDisplay_HardwareSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"OPALDisplayGroup"
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[OPALDisplay_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[OPALDisplay_Install.NT.Wdf]
UmdfService=OPALDisplay,OPALDisplay_Service
UmdfServiceOrder=OPALDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[OPALDisplay_Service]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\OPALDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
OPALDisplay.dll

[Strings]
ManufacturerName="xt9y"
DiskName="OPAL Virtual Display Driver"
DeviceName="OPAL Virtual Display"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
