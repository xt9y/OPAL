.DEFAULT_GOAL := macos-all

# Homebrew openssl@3 is keg-only. Make its pkg-config metadata visible before
# Makefile.core resolves the common FFmpeg/SDL/OpenSSL build flags.
HOMEBREW_OPENSSL_PREFIX ?= $(shell brew --prefix openssl@3 2>/dev/null)
ORIGINAL_PKG_CONFIG_PATH := $(PKG_CONFIG_PATH)
ifneq ($(strip $(HOMEBREW_OPENSSL_PREFIX)),)
PKG_CONFIG_PATH := $(HOMEBREW_OPENSSL_PREFIX)/lib/pkgconfig$(if $(strip $(ORIGINAL_PKG_CONFIG_PATH)),:$(ORIGINAL_PKG_CONFIG_PATH))
export PKG_CONFIG_PATH
endif

include Makefile.core

MACOSX_DEPLOYMENT_TARGET ?= 13.0
export MACOSX_DEPLOYMENT_TARGET
OPENSSL_CFLAGS := $(shell $(PKG_CONFIG) --cflags openssl 2>/dev/null)
OPENSSL_LIBS := $(shell $(PKG_CONFIG) --libs openssl 2>/dev/null)
OPENSSL_LIBRARY_FLAGS := $(shell $(PKG_CONFIG) --libs-only-L openssl 2>/dev/null)
# Several common test recipes intentionally retain their existing literal
# -lcrypto link. Supplying the keg-only Homebrew search path through CXXFLAGS
# keeps those shared recipes unchanged and lets Clang resolve libcrypto.
CXXFLAGS += -pthread -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) $(OPENSSL_LIBRARY_FLAGS)
CPPFLAGS += $(OPENSSL_CFLAGS) -DOPAL_PLATFORM_MACOS=1 \
	-DSDL_GetClipboardText=opal_macos_get_clipboard_text \
	-DSDL_SetClipboardText=opal_macos_set_clipboard_text

APPLE_FRAMEWORKS := \
	-framework Foundation \
	-framework AppKit \
	-framework CoreGraphics \
	-framework ApplicationServices \
	-framework ScreenCaptureKit \
	-framework CoreMedia \
	-framework CoreVideo \
	-framework VideoToolbox \
	-framework AudioToolbox

MACOS_INFO_PLIST := platform/macos/Info.plist
MACOS_INPUT_INFO_PLIST := platform/macos/InputHelper-Info.plist
MACOS_INFO_LDFLAGS := -Wl,-sectcreate,__TEXT,__info_plist,$(MACOS_INFO_PLIST)
MACOS_INPUT_INFO_LDFLAGS := -Wl,-sectcreate,__TEXT,__info_plist,$(MACOS_INPUT_INFO_PLIST)

MACOS_VIDEO_SRCS := \
	src/platform/macos/video_capture.cpp \
	src/native_video_pipeline.cpp \
	src/platform/macos/capture_backend.mm \
	src/platform/macos/video_encoder_backend.mm \
	src/platform/macos/audio_capture_backend.mm

MACOS_PLATFORM_SRCS := \
	src/platform/macos/host.cpp \
	src/platform/macos/system_backend.mm \
	src/platform/macos/clipboard_shim.mm \
	$(MACOS_VIDEO_SRCS)

CLIPBOARD_SRCS := src/clipboard.cpp
MACOS_INPUT_SRC := src/platform/macos/input_helper.mm
MACOS_NATIVE_MEDIA_TEST := $(BUILD)/test-macos-native-media-smoke

VIDEO_CAPTURE_SRCS := $(MACOS_VIDEO_SRCS)
DIRECT_SENDER_SRCS := $(VIDEO_SENDER_SRCS) $(VIDEO_CAPTURE_SRCS)
APP_SRCS := $(filter-out src/host.cpp src/system.cpp src/video_capture.cpp,$(APP_SRCS))
APP_SRCS += $(CLIPBOARD_SRCS) $(MACOS_PLATFORM_SRCS)

MACOS_FFMPEG_LIBS := $(AVLIBS) $(SWRLIBS)
AVLIBS := $(MACOS_FFMPEG_LIBS) $(APPLE_FRAMEWORKS)
NATIVE_MEDIA_LIBS := $(MACOS_FFMPEG_LIBS) $(SDL3_LIBS) $(APPLE_FRAMEWORKS)
LDFLAGS += $(MACOS_INFO_LDFLAGS)
LDLIBS := $(OPENSSL_LIBS) -pthread $(NATIVE_MEDIA_LIBS)

macos-deps-check:
	@os=$$(uname -s); arch=$$(uname -m)
	[ "$$os" = Darwin ] || { echo 'OPAL macOS build must run on macOS.' >&2; exit 1; }
	[ "$$arch" = arm64 ] || { echo 'OPAL currently supports Apple Silicon macOS (arm64) only.' >&2; exit 1; }
	command -v brew >/dev/null 2>&1 || { echo 'Homebrew is required. Install Homebrew, then: brew install make pkg-config sdl3 openssl@3 ffmpeg' >&2; exit 1; }
	command -v "$(PKG_CONFIG)" >/dev/null 2>&1 || { echo 'Missing pkg-config. Install: brew install make pkg-config sdl3 openssl@3 ffmpeg' >&2; exit 1; }
	command -v codesign >/dev/null 2>&1 || { echo 'Missing codesign. Install the Xcode Command Line Tools: xcode-select --install' >&2; exit 1; }
	[ -n "$(HOMEBREW_OPENSSL_PREFIX)" ] && [ -d "$(HOMEBREW_OPENSSL_PREFIX)/lib/pkgconfig" ] || { echo 'Homebrew openssl@3 pkg-config metadata unavailable. Install: brew install openssl@3' >&2; exit 1; }
	missing=''
	for pkg in openssl sdl3 libavformat libavcodec libavutil libswresample; do
		if ! "$(PKG_CONFIG)" --exists "$$pkg"; then missing="$$missing $$pkg"; fi
	done
	if [ -n "$$missing" ]; then
		echo "Missing macOS build modules:$$missing" >&2
		echo 'Install: brew install make pkg-config sdl3 openssl@3 ffmpeg' >&2
		exit 1
	fi

$(PRODUCT): $(CLIPBOARD_SRCS) $(MACOS_PLATFORM_SRCS) $(MACOS_INFO_PLIST) | macos-deps-check

macos-input: $(MACOS_INPUT_SRC) include/opal/input_record.hpp include/opal/input_wire.hpp $(MACOS_INPUT_INFO_PLIST) | $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -fobjc-arc $(MACOS_INPUT_SRC) $(MACOS_INPUT_INFO_LDFLAGS) -framework ApplicationServices -framework CoreGraphics -o $(BUILD)/opal-input

macos-sign: $(PRODUCT) macos-input
	codesign --force --sign - --identifier de.xt9y.opal "$(PRODUCT)"
	codesign --force --sign - --identifier de.xt9y.opal.input "$(BUILD)/opal-input"
	codesign --verify --strict "$(PRODUCT)"
	codesign --verify --strict "$(BUILD)/opal-input"

macos-all: macos-sign

# Deliberately install-only: build/sign as the logged-in user first. This keeps
# codesign out of sudo/root execution and preserves the exact binaries TCC saw.
macos-install:
	@test -x "$(PRODUCT)" -a -x "$(BUILD)/opal-input" || { echo 'Build first as your user: gmake -j"$$(sysctl -n hw.ncpu)"' >&2; exit 1; }
	codesign --verify --strict "$(PRODUCT)"
	codesign --verify --strict "$(BUILD)/opal-input"
	$(INSTALL) -d "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(LIBEXECDIR)"
	$(INSTALL) -m 0755 "$(PRODUCT)" "$(DESTDIR)$(BINDIR)/opal"
	$(INSTALL) -m 0755 "$(BUILD)/opal-input" "$(DESTDIR)$(LIBEXECDIR)/opal-input"

# Permission-free suite. Linux capture/systemd/uinput fixture tests are omitted;
# macOS-native capture is exercised separately by macos-runtime-test.
macos-test: test-platform-contract test-cross-platform-architecture test-platform-build-contract \
	test-native-video-pipeline test-video-sender-encoder-control test-audio-capture-backend \
	test-macos-media-scheduler test-macos-clipboard-contract test-macos-capture-contract \
	test-macos-videotoolbox-contract test-macos-audio-contract test-macos-host-permission-contract \
	test-udp-batch-contract test-core test-media-profile test-media test-input test-udp-transport \
	test-video-crypto test-video-packet test-video-reassembly test-video-feedback \
	test-video-receiver-architecture test-rendezvous-protocol test-rendezvous-server \
	test-local-discovery test-peer-handshake test-session-packet test-reliable-control \
	test-peer-session test-peer-session-relay test-relay test-daemon test-session test-hardening

$(MACOS_NATIVE_MEDIA_TEST): tests/test_macos_native_media_smoke.mm $(MACOS_VIDEO_SRCS) include/opal/*.hpp | $(BUILD) macos-deps-check
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) tests/test_macos_native_media_smoke.mm $(MACOS_VIDEO_SRCS) $(MACOS_FFMPEG_LIBS) $(APPLE_FRAMEWORKS) -o $@

test-macos-native-media-smoke: $(MACOS_NATIVE_MEDIA_TEST)
	$(MACOS_NATIVE_MEDIA_TEST)

macos-verify: macos-all macos-test
	codesign --verify --strict "$(PRODUCT)"
	codesign --verify --strict "$(BUILD)/opal-input"
	codesign -d --verbose=4 "$(PRODUCT)" 2>&1 | grep -q 'Identifier=de.xt9y.opal'
	codesign -d --verbose=4 "$(BUILD)/opal-input" 2>&1 | grep -q 'Identifier=de.xt9y.opal.input'
	strings "$(PRODUCT)" | grep -q 'NSScreenCaptureUsageDescription'
	strings "$(PRODUCT)" | grep -q 'NSAudioCaptureUsageDescription'
	@echo 'macOS build/sign/unit verification passed'

# Run this after granting Screen Recording. It exercises the real
# ScreenCaptureKit -> VideoToolbox/AAC pipeline and treats missing permission as
# a failure instead of a skip.
macos-runtime-test: macos-verify $(MACOS_NATIVE_MEDIA_TEST)
	OPAL_REQUIRE_MACOS_MEDIA=1 $(MACOS_NATIVE_MEDIA_TEST)
	@echo 'macOS native media runtime smoke passed'

.PHONY: macos-deps-check macos-input macos-sign macos-all macos-install macos-test \
	test-macos-native-media-smoke macos-verify macos-runtime-test
